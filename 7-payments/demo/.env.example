# Recommended default: a local validator (`solana-test-validator`), so setup/demo
# runs are instant and don't depend on the public devnet airdrop faucet, which is
# frequently rate-limited (429 "airdrop limit... or the faucet has run dry").
SOLANA_RPC_URL=http://127.0.0.1:8899

# To point this at real Solana devnet instead (slower, and the airdrop in `npm run
# setup` may need a few retries or a manual top-up from https://faucet.solana.com):
# SOLANA_RPC_URL=https://api.devnet.solana.com

SERVER_PORT=4021
SERVER_URL=http://localhost:4021
